<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<style>
{% include "_style.css.j2" %}
.sp-h1 { font-family: "Grotesk"; font-weight: 700; font-size: 112px; line-height: .95; letter-spacing: -.03em; margin-top: 40px; position: relative; }
.sp-why { margin-top: 30px; font-size: 32px; color: var(--ink-2); line-height: 1.35; position: relative; }
.sp-why b { color: var(--ink); }
.sp-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 56px; position: relative; }
.sp-stats .stat b { font-size: 70px; }
.sp-stats .stat i { font-size: 24px; }
.verdict { margin-top: 26px; background: linear-gradient(90deg, rgba(108,92,231,.35), rgba(108,92,231,.08)); border: 1px solid var(--line);
  border-radius: 22px; padding: 30px 34px; font-size: 29px; color: var(--ink-2); line-height: 1.4; position: relative; }
.verdict b { color: var(--ink); }
.hero { display: grid; grid-template-columns: 1fr 300px; gap: 40px; align-items: center; margin-top: 30px; position: relative; }
.hero .sp-h1 { margin-top: 0; }
.hero .sp-why { font-size: 30px; }
.hero-card { width: 300px; border-radius: 14px; transform: rotate(4deg); box-shadow: 0 24px 60px rgba(0,0,0,.55), 0 0 0 2px var(--accent-2); }
.hero ~ .sp-stats { margin-top: 48px; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.hero ~ .sp-stats .stat { padding: 24px 22px 22px; }
.hero ~ .sp-stats .stat b { font-size: 50px; }
.hero ~ .sp-stats .stat i { font-size: 20px; line-height: 1.25; display: block; margin-top: 4px; }
.inside { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; position: relative; }

/* CARTE CHIAVE */
.keys { margin-top: 34px; display: flex; flex-direction: column; gap: 24px; position: relative; }
.key { display: grid; grid-template-columns: 300px 1fr; gap: 40px; align-items: center;
  background: var(--bg-2); border: 1px solid var(--line); border-radius: 26px; padding: 28px 40px 28px 28px; height: 478px; }
.key .card { width: 300px; border-radius: 14px; box-shadow: 0 18px 40px rgba(0,0,0,.45); }
.key .card .qty { font-size: 28px; right: 10px; bottom: 10px; }
.role { display: inline-block; background: var(--accent-2); color: var(--ink); font-family: "Grotesk"; font-weight: 700;
  font-size: 22px; letter-spacing: .14em; padding: 9px 18px; border-radius: 10px; }
.role .n { color: var(--t1); margin-right: 10px; }
.key h3 { font-family: "Grotesk"; font-weight: 700; font-size: 52px; line-height: 1.02; letter-spacing: -.01em; margin-top: 22px; }
.key p { font-size: 29px; line-height: 1.4; color: var(--ink-2); margin-top: 18px; }

/* PIANO DI GIOCO */
.steps { margin-top: 40px; display: flex; flex-direction: column; position: relative; }
.step { display: grid; grid-template-columns: 110px 1fr; column-gap: 10px; padding: 26px 0; border-bottom: 1px solid var(--line); }
.step:first-child { padding-top: 0; }
.step .num { font-family: "Grotesk"; font-weight: 700; font-size: 64px; line-height: 1; color: var(--accent); }
.step .fase { font-size: 22px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
.step .txt { font-size: 30px; line-height: 1.38; margin-top: 8px; }
.pros { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 34px; position: relative; }
.pros .box { background: var(--bg-2); border: 1px solid var(--line); border-radius: 22px; padding: 28px 30px; }
.pros h4 { font-size: 22px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 14px; }
.pros h4 .ar { margin-right: 8px; font-size: 18px; }
.pros .up h4 .ar { color: var(--up); } .pros .down h4 .ar { color: var(--down); }
.pros li { list-style: none; font-size: 25px; line-height: 1.38; color: var(--ink); padding: 8px 0; }
.pros li + li { border-top: 1px solid var(--line); }

/* CHIUSURA */
.ask { margin-top: 70px; background: linear-gradient(90deg, rgba(108,92,231,.35), rgba(108,92,231,.08)); border: 1px solid var(--line);
  border-radius: 22px; padding: 34px 36px; font-size: 32px; line-height: 1.4; color: var(--ink-2); position: relative; }
.ask b { color: var(--ink); }
</style>
</head>
<body>
{% set logo %}<svg class="logo" width="40" height="40" viewBox="0 0 100 100" aria-hidden="true"><rect x="30" y="12" width="56" height="56" rx="13" fill="#9D8CFF"></rect><rect x="14" y="32" width="56" height="56" rx="13" fill="#6C5CE7" stroke="#15122E" stroke-width="5"></rect></svg>{% endset %}
{% set brand %}<div class="brand">{{ logo }}INDIGO META<span class="wk">SETTIMANA {{ r.week }}</span></div>{% endset %}

{# ---------- 1. COPERTINA ---------- #}
<section class="slide">
  {{ brand }}
  <div class="kicker">Mazzo sotto la lente</div>
  {% if hero %}
  <div class="hero">
    <div class="hero-txt">
      <div class="sp-h1" style="font-size:{{ 96 if sp.name|length <= 16 else 78 }}px">{{ sp.name }}</div>
      <div class="sp-why">{{ why|safe }}</div>
    </div>
    <div class="card hero-card">
      {% if hero.src %}<img src="{{ hero.src }}" alt="{{ hero.name }}">{% else %}<div class="ph"><em>{{ hero.section }}</em><span>{{ hero.name }}</span></div>{% endif %}
    </div>
  </div>
  {% else %}
  <div class="sp-h1">{{ sp.name }}</div>
  <div class="sp-why">{{ why|safe }}</div>
  {% endif %}
  <div class="sp-stats">
    <div class="stat"><b>{{ pct(sp.share) }}</b><i>meta share</i></div>
    <div class="stat"><b>{{ pp(sp.delta) if sp.delta is not none else "–" }}</b><i>vs settimana {{ r.week - 1 }}</i></div>
    <div class="stat"><b>{{ sp.top8 }}</b><i>top 8 su {{ sp.entries }} liste</i></div>
    <div class="stat"><b>{{ pct(sp.conversion) }}</b><i>conversion (media {{ pct(avg_conv) }})</i></div>
  </div>
  <div class="verdict">{{ verdict|safe }}</div>
  {% if an %}<div class="inside"><span class="pill">Carte chiave</span>{% if an.piano %}<span class="pill">Piano di gioco</span>{% endif %}<span class="pill">Lista completa</span></div>{% endif %}
  <div class="swipe">{{ "Le carte chiave →" if an else "La lista →" }}</div>
  <div class="foot"><span>Dati: Limitless TCG · {{ dates_it }}</span><span class="page">1/{{ n_slides }}</span></div>
</section>

{% if an %}
{# ---------- 2. CARTE CHIAVE ---------- #}
{% for page in an.pages %}{% set pi = loop.index0 %}
<section class="slide">
  {{ brand }}
  <div class="kicker" style="margin-top:44px">Le carte chiave{% if an.pages|length > 1 %} · {{ loop.index }}/{{ an.pages|length }}{% endif %}</div>
  <div class="keys">
  {% for k in page %}
    <div class="key">
      <div class="card">
        {% if k.src %}<img src="{{ k.src }}" alt="{{ k.name }}">{% else %}<div class="ph"><em>{{ k.section }}</em><span>{{ k.name }}</span></div>{% endif %}
        <b class="qty">×{{ k.count }}</b>
      </div>
      <div>
        <span class="role"><span class="n">{{ "%02d"|format(pi * 2 + loop.index) }}</span>{{ k.role }}</span>
        <h3>{{ k.name }}</h3>
        <p>{{ k.why }}</p>
      </div>
    </div>
  {% endfor %}
  </div>
  <div class="foot" style="font-size:17px"><span>Carte © Pokémon / Nintendo / Creatures / GAME FREAK</span><span class="page">{{ 2 + pi }}/{{ n_slides }}</span></div>
</section>
{% endfor %}

{# ---------- 3. PIANO DI GIOCO ---------- #}
{% if an.piano %}
<section class="slide">
  {{ brand }}
  <div class="kicker" style="margin-top:44px">Come si gioca</div>
  <h2 style="font-size:66px; margin-bottom:6px">Il piano di gioco</h2>
  <div class="steps">
  {% for p in an.piano %}
    <div class="step"><div class="num">{{ "%02d"|format(loop.index) }}</div>
      <div><div class="fase">{{ p.fase }}</div><div class="txt">{{ p.testo }}</div></div></div>
  {% endfor %}
  </div>
  {% if an.forza or an.occhio %}
  <div class="pros">
    <div class="box up"><h4><span class="ar">▲</span>Punti di forza</h4><ul>{% for x in an.forza %}<li>{{ x }}</li>{% endfor %}</ul></div>
    <div class="box down"><h4><span class="ar">▼</span>Occhio a</h4><ul>{% for x in an.occhio %}<li>{{ x }}</li>{% endfor %}</ul></div>
  </div>
  {% endif %}
  <div class="foot"><span>Analisi Indigo Meta sui testi ufficiali delle carte</span><span class="page">{{ deck_page - 1 }}/{{ n_slides }}</span></div>
</section>
{% endif %}
{% endif %}

{# ---------- 4. LISTA ---------- #}
{% include "_deck_slide.html.j2" %}

{# ---------- 5. CHIUSURA ---------- #}
{% if an %}
<section class="slide cta">
  {{ brand }}
  <h2 style="font-size:80px">Ogni settimana un mazzo,<br>carta per carta.</h2>
  <div class="handle">{{ handle }}</div>
  <div class="ask"><b>Lo porteresti al prossimo torneo?</b><br>Scrivilo nei commenti, e salva il post per avere la lista sempre a portata di mano.</div>
  <div class="foot"><span>Dati: Limitless TCG (limitlesstcg.com)</span><span class="page">{{ n_slides }}/{{ n_slides }}</span></div>
</section>
{% endif %}
</body>
</html>
