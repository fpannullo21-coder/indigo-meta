<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<style>
{% include "_style.css.j2" %}
.ch-h1 { font-family: "Grotesk"; font-weight: 700; font-size: 104px; line-height: .95; letter-spacing: -.03em; margin-top: 30px; position: relative; }
.ch-sub { font-size: 30px; color: var(--ink-2); margin-top: 24px; position: relative; }
.champ { margin-top: 50px; background: linear-gradient(120deg, rgba(108,92,231,.45), rgba(108,92,231,.10)); border: 1px solid var(--line);
  border-radius: 26px; padding: 36px 38px; position: relative; }
.champ em { font-style: normal; font-size: 20px; font-weight: 700; letter-spacing: .12em; color: var(--t1); text-transform: uppercase; }
.champ b { display: block; font-family: "Grotesk"; font-size: 66px; font-weight: 700; line-height: 1.05; margin-top: 10px; }
.champ i { display: block; font-style: normal; font-size: 28px; color: var(--ink-2); margin-top: 10px; }
.chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 34px; position: relative; }
.chip { background: var(--bg-2); border: 1px solid var(--line); border-radius: 999px; padding: 10px 20px; font-size: 23px; font-weight: 600; }
.chip b { font-family: "Grotesk"; color: var(--accent); margin-right: 6px; }
.t8 { margin-top: 40px; position: relative; }
.t8row { display: grid; grid-template-columns: 70px 1fr 300px 130px; column-gap: 16px; align-items: center; height: 96px; border-bottom: 1px solid var(--line); }
.t8row .pl { font-family: "Grotesk"; font-size: 40px; font-weight: 700; color: var(--ink-3); }
.t8row.p1 .pl { color: var(--t1); }
.t8row .who b { display: block; font-size: 29px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.t8row .who i { display: block; font-style: normal; font-size: 21px; color: var(--ink-3); margin-top: 4px; }
.t8row .dk { font-size: 25px; font-weight: 600; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.t8row .rc { font-family: "Grotesk"; font-size: 28px; font-weight: 700; text-align: right; }
.t8row.it { background: rgba(108,92,231,.22); }
.t8row.it .who i { color: var(--t1); font-weight: 600; }
.prof-name { font-family: "Grotesk"; font-weight: 700; font-size: 92px; line-height: 1; letter-spacing: -.02em; margin-top: 26px; position: relative; }
.prof-sub { font-size: 30px; color: var(--ink-2); margin-top: 18px; position: relative; }
.pstats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 44px; position: relative; }
.pstats .stat b { font-size: 54px; }
.pstats .stat i { font-size: 21px; }
.path { margin-top: 34px; position: relative; }
.path h4 { font-size: 21px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
.prow { display: grid; grid-template-columns: 180px 1fr 70px; column-gap: 16px; align-items: center; height: 96px; border-bottom: 1px solid var(--line); }
.prow .ph { font-size: 22px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); }
.prow .op b { display: block; font-size: 28px; font-weight: 700; }
.prow .op i { display: block; font-style: normal; font-size: 22px; color: var(--ink-2); margin-top: 4px; }
.prow .res { justify-self: end; width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
  font-family: "Grotesk"; font-weight: 700; font-size: 28px; background: var(--accent-2); }
.prow .res.S { background: var(--bg-2); border: 1px solid var(--line); color: var(--ink-3); }
</style>
</head>
<body>
{% set logo %}<svg class="logo" width="40" height="40" viewBox="0 0 100 100" aria-hidden="true"><rect x="30" y="12" width="56" height="56" rx="13" fill="#9D8CFF"></rect><rect x="14" y="32" width="56" height="56" rx="13" fill="#6C5CE7" stroke="#15122E" stroke-width="5"></rect></svg>{% endset %}
{% set c = m.top[0] %}

<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ brand_right }}</span></div>
  <div class="kicker">I mazzi dei campioni · {{ category }}</div>
  <div class="ch-h1">{{ m.name }}</div>
  <div class="ch-sub">{% if venue.flag %}{{ venue.flag }} {{ venue.country }} · {% endif %}{{ date_it }} · {{ num(m.players) }} giocatori · {{ category }}</div>
  <div class="champ"><em>Campione</em><b>{{ c.name }}</b><i>{{ c.flag }} {{ c.country }} · {{ c.deck }} · {{ c.record }}</i></div>
  <div class="kicker" style="margin-top:46px; font-size:21px">Mazzi in top 8</div>
  <div class="chips" style="margin-top:16px">{% for name, n in deck_counts %}<span class="chip"><b>{{ n }}</b>{{ name }}</span>{% endfor %}</div>
  <div class="swipe">La top 8 →</div>
  <div class="foot"><span>Dati: Limitless TCG · RK9</span><span class="page">1/{{ n_slides }}</span></div>
</section>

<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ brand_right }}</span></div>
  <div class="kicker">Top 8 · {{ m.name }} {{ venue.flag }} · {{ category }}</div>
  <h2>Chi è arrivato in fondo</h2>
  <div class="t8">
  {% for p in m.top %}
    <div class="t8row p{{ p.place }}{% if p.cc == 'IT' %} it{% endif %}"><span class="pl">{{ p.place }}</span>
      <span class="who"><b>{{ p.name }}</b><i>{{ p.flag }} {{ p.country }}</i></span><span class="dk">{{ p.deck }}</span><span class="rc">{{ p.record }}</span></div>
  {% endfor %}
  </div>
  <div class="foot"><span>Record complessivo, top cut compresa{% if italians %} · in evidenza gli italiani{% endif %}</span><span class="page">2/{{ n_slides }}</span></div>
</section>

<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ brand_right }}</span></div>
  <div class="kicker">Il campione · {{ category }}</div>
  <div class="prof-name">{{ c.name }}</div>
  <div class="prof-sub">{{ c.flag }} {{ c.country }} · ha vinto con <b style="color:var(--ink)">{{ c.deck }}</b></div>
  <div class="pstats">
    <div class="stat"><b>{{ c.record }}</b><i>record totale</i></div>
    <div class="stat"><b>{{ swiss }}</b><i>nei turni svizzeri</i></div>
    <div class="stat"><b>{{ c.opw or "–" }}</b><i>forza avversari (OPW)</i></div>
  </div>
  {% if c.path %}
  <div class="path"><h4>La strada verso il titolo</h4>
  {% for phase, opp, deck, res, fl in c.path %}
    <div class="prow"><span class="ph">{{ phase }}</span><span class="op"><b>{{ opp }}{% if fl %} {{ fl }}{% endif %}</b><i>{{ deck }}</i></span><span class="res {{ res }}">{{ res }}</span></div>
  {% endfor %}
  </div>
  {% endif %}
  <div class="foot"><span>OPW = % di vittorie degli avversari affrontati · fonte: Limitless Labs</span><span class="page">3/{{ n_slides }}</span></div>
</section>

{% for d in decks %}{% set deck = d %}{% set deck_page = loop.index + 3 %}{% include "_deck_slide.html.j2" %}{% endfor %}
</body>
</html>
