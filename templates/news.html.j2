<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<style>
{% include "_style.css.j2" %}
.n-title { font-family: "Grotesk"; font-weight: 700; font-size: 78px; line-height: 1.02; letter-spacing: -.02em; margin-top: 22px; position: relative; }
.n-title em { font-style: normal; color: var(--accent); }
.n-lead { font-size: 30px; color: var(--ink-2); margin-top: 22px; line-height: 1.35; position: relative; }
.n-pic { margin-top: 40px; height: 600px; border-radius: 26px; overflow: hidden; position: relative;
  background: radial-gradient(ellipse at 30% 20%, rgba(157,140,255,.35), transparent 60%), var(--bg-2); border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center; gap: 34px; }
.n-pic img { height: 520px; max-width: 470px; object-fit: contain; border-radius: 18px; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
.n-pic img.cut { box-shadow: none; border-radius: 0; height: auto; max-height: 540px; max-width: 420px; min-width: 0; flex: 0 1 auto;
  filter: drop-shadow(0 22px 40px rgba(0,0,0,.6)); }
.n-pic .ph { width: 330px; height: 460px; border-radius: 18px; border: 2px dashed var(--accent); display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center; padding: 30px; box-sizing: border-box; color: var(--ink-2); font-size: 22px; line-height: 1.35; }
.n-pic .ph b { color: var(--ink); font-size: 30px; margin-bottom: 12px; font-family: "Grotesk"; }
.n-tag { position: absolute; left: 24px; top: 24px; background: var(--accent-2); border-radius: 999px; padding: 8px 18px; font-size: 20px; font-weight: 700; letter-spacing: .06em; }
.pts { margin-top: 40px; position: relative; display: flex; flex-direction: column; gap: 18px; }
.pt { display: grid; grid-template-columns: 64px 1fr; column-gap: 20px; align-items: start; background: var(--bg-2); border: 1px solid var(--line);
  border-radius: 22px; padding: 26px 30px; }
.pt .ic { font-family: "Grotesk"; font-size: 40px; font-weight: 700; color: var(--accent); line-height: 1; }
.pt p { font-size: 27px; line-height: 1.38; color: var(--ink-2); }
.pt p b { color: var(--ink); }
.why { margin-top: 26px; position: relative; border-left: 6px solid var(--accent); padding: 6px 0 6px 26px; }
.why em { font-style: normal; font-size: 21px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
.why p { font-size: 27px; line-height: 1.4; color: var(--ink); margin-top: 8px; }
.pts, .why { flex-shrink: 0; }
.gal { display: flex; justify-content: center; gap: 30px; margin-top: 70px; position: relative; flex-shrink: 0; }
.gal .it { text-align: center; }
.gal img, .gal .ph { width: 280px; aspect-ratio: 63/88; border-radius: 16px; object-fit: cover; box-shadow: 0 22px 54px rgba(0,0,0,.55); display: block; }
.gal .it:nth-child(2) img, .gal .it:nth-child(2) .ph { transform: translateY(-24px); }
.gal .ph { border: 2px dashed var(--accent); display: flex; align-items: center; justify-content: center; font-size: 22px; color: var(--ink-2); box-sizing: border-box; }
.gal b { display: block; font-family: "Grotesk"; font-size: 46px; margin-top: 18px; color: var(--accent); }
.gal i { display: block; font-style: normal; font-size: 24px; color: var(--ink-2); margin-top: 2px; }
.gal-text { font-size: 29px; line-height: 1.42; color: var(--ink-2); margin-top: 46px; position: relative; text-align: center; }
.gal-text b { color: var(--ink); }
/* SCHEDA CARTA (n.focus) */
.fx { display: grid; grid-template-columns: 400px 1fr; gap: 40px; margin-top: 34px; position: relative; align-items: start; }
.fx img { width: 400px; border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,.55), 0 0 0 2px var(--accent-2); display: block; }
.fx .chips { display: flex; flex-wrap: wrap; gap: 10px; }
.fx .chip { background: var(--bg-2); border: 1px solid var(--line); border-radius: 999px; padding: 8px 18px; font-size: 22px; font-weight: 700; color: var(--ink); }
.fx .frow { margin-top: 22px; }
.fx .frow em { font-style: normal; display: block; font-size: 20px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
.fx .frow p { font-size: 26px; line-height: 1.36; color: var(--ink-2); margin-top: 6px; }
.fx .frow p b { color: var(--ink); }
.big { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 30px; position: relative; }
.big div { background: var(--bg-2); border: 1px solid var(--line); border-radius: 20px; padding: 22px 24px; }
.big b { display: block; font-family: "Grotesk"; font-size: 56px; line-height: 1; color: var(--ink); }
.big i { display: block; font-style: normal; font-size: 21px; color: var(--ink-2); margin-top: 8px; line-height: 1.25; }
.fverd { margin-top: 24px; background: linear-gradient(90deg, rgba(108,92,231,.35), rgba(108,92,231,.08)); border: 1px solid var(--line);
  border-radius: 22px; padding: 24px 30px; font-size: 27px; line-height: 1.38; color: var(--ink-2); position: relative; }
.fverd b { color: var(--ink); }
/* ALLENATORI (n.trainers) */
.tr { display: grid; grid-template-columns: 168px 1fr; gap: 28px; align-items: center; background: var(--bg-2); border: 1px solid var(--line);
  border-radius: 24px; padding: 14px 28px 14px 14px; margin-top: 14px; position: relative; }
.tr img { width: 168px; border-radius: 10px; display: block; box-shadow: 0 14px 34px rgba(0,0,0,.45); }
.tr .ty, .trx .ty { display: inline-block; background: var(--accent-2); border-radius: 8px; padding: 6px 14px; font-size: 19px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.tr h3, .trx h3 { font-family: "Grotesk"; font-size: 38px; line-height: 1.05; margin-top: 12px; }
.tr p, .trx p { font-size: 24.5px; line-height: 1.36; color: var(--ink-2); margin-top: 8px; }
.tr p b, .trx p b { color: var(--ink); }
.trx { background: var(--bg-2); border: 1px solid var(--line); border-radius: 24px; padding: 20px 30px; margin-top: 18px; position: relative; }
.trx h3 { display: inline; margin-left: 14px; font-size: 32px; }
.miss { margin-top: 18px; border: 2px dashed var(--accent); border-radius: 22px; padding: 20px 28px; font-size: 24.5px; line-height: 1.36; color: var(--ink-2); position: relative; }
.miss b { color: var(--ink); }
.n-cta { margin-top: 30px; background: var(--accent-2); border-radius: 22px; padding: 26px 30px; font-size: 28px; line-height: 1.38; color: var(--ink); position: relative; }
</style>
</head>
<body>
{% set logo %}<svg class="logo" width="40" height="40" viewBox="0 0 100 100" aria-hidden="true"><rect x="30" y="12" width="56" height="56" rx="13" fill="#9D8CFF"></rect><rect x="14" y="32" width="56" height="56" rx="13" fill="#6C5CE7" stroke="#15122E" stroke-width="5"></rect></svg>{% endset %}

{% set tot = 2 + (n.focus or [])|length + (1 if n.trainers else 0) + (1 if n.gallery else 0) %}
<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ n.where }}</span></div>
  <div class="kicker">News · {{ n.category }}</div>
  <div class="n-title">{{ n.title | safe }}</div>
  <div class="n-lead">{{ n.lead | safe }}</div>
  <div class="n-pic">
    {% for im in n.images %}
      {% if im.src %}<img src="{{ im.src }}" alt="{{ im.label }}"{% if im.cut %} class="cut"{% endif %}>
      {% else %}<div class="ph"><b>{{ im.label }}</b>immagine ufficiale<br>della carta</div>{% endif %}
    {% endfor %}
  </div>
  <div class="swipe">{{ n.swipe or "Cosa sapere →" }}</div>
  <div class="foot"><span>Fonte: {{ n.source }}</span><span class="page">1/{{ tot }}</span></div>
</section>

{% for f in n.focus or [] %}
<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ n.where }}</span></div>
  <div class="kicker" style="margin-top:44px">{{ f.tag }}</div>
  <h2 style="font-size:66px">{{ f.name }}</h2>
  <div class="fx">
    <img src="{{ f.src }}" alt="{{ f.name }}">
    <div>
      <div class="chips">{% for c in f.chips %}<span class="chip">{{ c }}</span>{% endfor %}</div>
      {% for label, text in f.rows %}<div class="frow"><em>{{ label }}</em><p>{{ text | safe }}</p></div>{% endfor %}
    </div>
  </div>
  <div class="big">{% for b, i in f.big %}<div><b>{{ b }}</b><i>{{ i }}</i></div>{% endfor %}</div>
  <div class="fverd">{{ f.verdict | safe }}</div>
  <div class="foot" style="font-size:17px"><span>{{ n.focus_note or ("Fonte: " ~ n.source) }}</span><span class="page">{{ 1 + loop.index }}/{{ tot }}</span></div>
</section>
{% endfor %}
{% if n.trainers %}{% set t = n.trainers %}
<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ n.where }}</span></div>
  <div class="kicker" style="margin-top:44px">{{ t.kicker }}</div>
  <h2 style="font-size:58px; margin-bottom:8px">{{ t.title }}</h2>
  {% for c in t.cards %}
  <div class="tr"><img src="{{ c.src }}" alt="{{ c.name }}"><div><span class="ty">{{ c.type }}</span><h3>{{ c.name }}</h3><p>{{ c.text | safe }}</p></div></div>
  {% endfor %}
  {% for c in t.extra or [] %}
  <div class="trx"><span class="ty">{{ c.type }}</span><h3>{{ c.name }}</h3><p>{{ c.text | safe }}</p></div>
  {% endfor %}
  {% if t.missing %}<div class="miss">{{ t.missing | safe }}</div>{% endif %}
  <div class="foot" style="font-size:17px"><span>{{ t.note or n.focus_note }}</span><span class="page">{{ 2 + (n.focus or [])|length }}/{{ tot }}</span></div>
</section>
{% endif %}

<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ n.where }}</span></div>
  <div class="kicker">Cosa sapere</div>
  <h2 style="font-size:60px">{{ n.short }}</h2>
  <div class="pts">
  {% for icon, text in n.points %}
    <div class="pt"><span class="ic">{{ icon }}</span><p>{{ text | safe }}</p></div>
  {% endfor %}
  </div>
  <div class="why"><em>Perché conta per il competitivo</em><p>{{ n.why | safe }}</p></div>
  {% if n.cta %}<div class="n-cta">{{ n.cta | safe }}</div>{% endif %}
  <div class="foot"><span>Fonte: {{ n.source }}</span><span class="page">{{ 2 + (n.focus or [])|length + (1 if n.trainers else 0) }}/{{ tot }}</span></div>
</section>
{% if n.gallery %}
<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">{{ n.where }}</span></div>
  <div class="kicker">{{ n.gallery.kicker }}</div>
  <h2 style="font-size:64px">{{ n.gallery.title }}</h2>
  <div class="gal">{% for c in n.gallery.cards %}<div class="it">{% if c.src %}<img src="{{ c.src }}" alt="{{ c.label }}">{% else %}<div class="ph">{{ c.label }}</div>{% endif %}<b>{{ c.year }}</b><i>{{ c.label }}</i></div>{% endfor %}</div>
  <div class="gal-text">{{ n.gallery.text | safe }}</div>
  <div class="foot"><span>{{ n.gallery.note or ("Fonte: " ~ n.source) }}</span><span class="page">{{ tot }}/{{ tot }}</span></div>
</section>
{% endif %}
</body>
</html>
