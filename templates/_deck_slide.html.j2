{# ---------- LISTA DELLA SETTIMANA ---------- #}
<section class="slide deck">
  <div class="brand"><svg class="logo" width="40" height="40" viewBox="0 0 100 100" aria-hidden="true"><rect x="30" y="12" width="56" height="56" rx="13" fill="#9D8CFF"></rect><rect x="14" y="32" width="56" height="56" rx="13" fill="#6C5CE7" stroke="#15122E" stroke-width="5"></rect></svg>INDIGO META<span class="wk">{{ brand_right if brand_right is defined else "SETTIMANA " ~ r.week }}</span></div>
  <div class="kicker" style="margin-top:36px">{{ deck.kicker if deck.kicker is defined else "Lista della settimana" }}</div>
  <h2 style="font-size:60px; margin-top:12px">{{ deck.name }}</h2>
  {% set mix %}{% for label, n in deck.counts %}{{ n }} {{ label }}{% if not loop.last %} · {% endif %}{% endfor %}{% endset %}
  {% set champ = deck.kicker is defined %}
  <div class="sub" style="font-size:23px; margin-top:10px; line-height:1.3">{{ deck.place }}° posto su {{ deck.players }} giocatori · {% if champ %}{{ mix }}{% else %}{{ deck.tournament }}{% endif %}<br>
    {{ deck.player }}{% if deck.country is defined and deck.country %} {{ deck.flag }} {{ deck.country }}{% endif %} · {{ deck.record }}{% if deck.price %} · costo indicativo {{ deck.price }}{% endif %}{% if not champ %} · {{ mix }}{% endif %}</div>
  {% if deck.price %}<div class="pricenote">Costo indicativo: somma dei prezzi «trend» Cardmarket delle 60 carte singole (dati TCGdex, {{ deck.price_date }}). Spedizione esclusa.</div>{% endif %}
  <div class="cards" style="{% if deck.price %}margin-top:12px; {% endif %}grid-template-columns: repeat({{ deck.cols }}, minmax(0, 1fr))">
  {% for c in deck.cards %}
    <div class="card">
      {% if c.src %}<img src="{{ c.src }}" alt="{{ c.name }}">
      {% elif c.energy_color %}<div class="ph energy" style="background: {{ c.energy_color }}"><span style="color: {{ c.energy_ink }}">{{ c.name }}</span></div>
      {% else %}<div class="ph"><em>{{ c.section }}</em><span>{{ c.name }}</span><small>{{ c.set_code }} {{ c.number }} · immagine in arrivo</small></div>{% endif %}
      <b class="qty">×{{ c.count }}</b>
    </div>
  {% endfor %}
  {% if deck.summary_span %}
    <div class="sumtile" style="grid-column: span {{ deck.summary_span }}">
      <div class="tot">
        <div class="big">{{ deck.total }}</div>
        <div class="lbl">carte</div>
        {% if deck.summary_span >= 2 %}<div class="note">{% if deck.price %}circa {{ deck.price }}{% else %}{{ deck.unique }} diverse{% endif %}</div>{% endif %}
      </div>
      {% if deck.summary_span >= 2 %}
      <div class="mix">{% for label, n in deck.counts %}<div><b>{{ n }}</b>{{ label }}</div>{% endfor %}</div>
      {% endif %}
    </div>
  {% endif %}
  </div>
  <div class="foot" style="font-size:17px"><span>Carte © Pokémon / Nintendo / Creatures / GAME FREAK · immagini TCGdex e Limitless TCG</span><span class="page">{{ deck_page }}/{{ n_slides }}</span></div>
</section>
