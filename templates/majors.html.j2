<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<style>
{% include "_style.css.j2" %}
.m-h1 { font-family: "Grotesk"; font-weight: 700; font-size: 128px; line-height: .92; letter-spacing: -.03em; margin-top: 90px; position: relative; }
.m-h1 span { color: var(--accent); display: block; }
.m-sub { font-size: 32px; color: var(--ink-2); margin-top: 28px; line-height: 1.3; position: relative; }
.hl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 60px; position: relative; }
.hl .stat b { font-size: 40px; line-height: 1.05; }
.hl .stat i { display: block; margin-top: 10px; font-size: 22px; }
.hl .stat em { font-style: normal; display: block; font-size: 18px; color: var(--accent); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 10px; font-weight: 600; }
.legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 40px; position: relative; font-size: 22px; color: var(--ink-2); }
.mlist { margin-top: 40px; position: relative; }
.month { font-family: "Grotesk"; font-size: 32px; font-weight: 700; margin-top: 16px; padding-bottom: 10px; border-bottom: 2px solid var(--accent-2); }
.month:first-child { margin-top: 0; }
.ev { display: grid; grid-template-columns: 150px 128px 1fr; column-gap: 16px; align-items: center; height: 54px; border-bottom: 1px solid var(--line); }
.ev .dt { font-family: "Grotesk"; font-size: 25px; font-weight: 700; }
.ev .nm { font-size: 26px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ev .nm small { font-size: 20px; color: var(--ink-3); font-weight: 500; margin-left: 10px; }
.ev.eu .nm { color: var(--t1); }
.ev.it { background: rgba(108,92,231,.22); }
.tp { justify-self: start; font-size: 17px; font-weight: 700; letter-spacing: .06em; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--line); color: var(--ink-2); }
.tp.IC, .tp.WC { background: var(--accent-2); color: var(--ink); border-color: var(--accent-2); }
.tp.SPE { background: var(--bg-2); color: var(--t1); }
</style>
</head>
<body>
{% set logo %}<svg class="logo" width="40" height="40" viewBox="0 0 100 100" aria-hidden="true"><rect x="30" y="12" width="56" height="56" rx="13" fill="#9D8CFF"></rect><rect x="14" y="32" width="56" height="56" rx="13" fill="#6C5CE7" stroke="#15122E" stroke-width="5"></rect></svg>{% endset %}
<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">STAGIONE 2027</span></div>
  <div class="m-h1">Calendario<span>dei major</span></div>
  <div class="m-sub">Regional, Special, Internazionali e Mondiali: tutte le date fino ad agosto.</div>
  <div class="hl">
    <div class="stat"><em>Il prossimo</em><b>{{ nxt.name }}</b><i>{{ nxt.when }}</i></div>
    <div class="stat"><em>In Italia</em><b>Bologna</b><i>{{ italy.when }}</i></div>
    <div class="stat"><em>Europa</em><b>EUIC Londra</b><i>{{ euic.when }}</i></div>
  </div>
  <div class="legend"><span class="tp IC">IC</span> Internazionale <span class="tp REG">REG</span> Regional <span class="tp SPE">SPE</span> Special Event</div>
  <div class="swipe">Tutte le date →</div>
  <div class="foot"><span>Fonte: calendario ufficiale Play! Pokémon</span><span class="page">1/{{ n_slides }}</span></div>
</section>
{% for page in pages %}
<section class="slide">
  <div class="brand">{{ logo }}INDIGO META<span class="wk">STAGIONE 2027</span></div>
  <div class="mlist">
  {% for month, evs in page %}
    <div class="month">{{ month }}</div>
    {% for e in evs %}
    <div class="ev {{ e.cls }}"><span class="dt">{{ e.when }}</span><span class="tp {{ e.type }}">{{ e.label }}</span>
      <span class="nm">{{ e.name }}<small>{{ e.country }}</small></span></div>
    {% endfor %}
  {% endfor %}
  </div>
  <div class="foot"><span>In evidenza gli eventi in Europa · date soggette a variazioni</span><span class="page">{{ loop.index + 1 }}/{{ n_slides }}</span></div>
</section>
{% endfor %}
</body>
</html>
